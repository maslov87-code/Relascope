<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ведомость таксации круговыми реласкопическими площадками" android:textStyle="bold" android:textSize="16sp"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <ScrollView android:layout_width="wrap_content" android:layout_height="match_parent">
            <TableLayout android:id="@+id/table" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </ScrollView>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnCsv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Экспорт CSV"/>
        <Button android:id="@+id/btnXlsx" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Экспорт XLSX"/>
    </LinearLayout>
    <Button android:id="@+id/btnNew" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="НОВЫЙ ПЕРЕЧЁТ"/>
</LinearLayout>
