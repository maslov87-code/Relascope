<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <com.relascope.app.ui.CalibView android:id="@+id/calibView" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:background="#CC000000" android:padding="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Закрепите реласкоп на цепочке 1 м от камеры, сделайте фото, подтвердите границы прорези" android:textColor="#FFFFFF" android:textSize="12sp"/>
        <Button android:id="@+id/btnCapture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сделать фото"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Левая граница" android:textColor="#FFFFFF"/>
        <SeekBar android:id="@+id/sbLeft" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Правая граница" android:textColor="#FFFFFF"/>
        <SeekBar android:id="@+id/sbRight" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnRetake" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Переснять"/>
            <Button android:id="@+id/btnConfirm" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Подтвердить"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
