<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Реласкоп — перечёт КРП" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvCalib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#B71C1C"/>
    <EditText android:id="@+id/etArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Площадь лесосеки, га" android:inputType="numberDecimal" android:layout_marginTop="16dp"/>
    <Spinner android:id="@+id/spCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <Spinner android:id="@+id/spDensity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="НАЧАТЬ ПЕРЕЧЁТ" android:layout_marginTop="24dp"/>
    <Button android:id="@+id/btnContinue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ПРОДОЛЖИТЬ СЕССИЮ"/>
    <Button android:id="@+id/btnResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="РЕЗУЛЬТАТЫ"/>
    <Button android:id="@+id/btnCalib" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="КАЛИБРОВКА"/>
</LinearLayout>
